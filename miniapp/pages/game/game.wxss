.game-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #E3F2FD;
  overflow: hidden;
  position: relative;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 2rpx solid #E0E0E0;
  height: 70rpx;
  z-index: 10;
}

.status-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.status-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.status-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.status-value.danger {
  color: #F44336;
  animation: pulse 0.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.hp-item {
  flex: 1;
  margin-right: 10rpx;
}

.hp-bar-bg {
  width: 120rpx;
  height: 16rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 8rpx;
}

.hp-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s, background 0.3s;
}

.hp-text {
  font-size: 20rpx;
  color: #666;
  min-width: 70rpx;
}

.pause-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #F5F5F5;
  border-radius: 50%;
}

.pause-btn:active {
  background: #E0E0E0;
}

/* 连击徽章 */
.combo-badge {
  display: flex;
  align-items: center;
  padding: 2rpx 14rpx;
  background: linear-gradient(135deg, #FF6D00, #FF1744);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 109, 0, 0.4);
  animation: comboPop 0.3s ease-out;
}

.combo-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

@keyframes comboPop {
  0% { transform: scale(0.3); opacity: 0; }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}

/* Buff指示器 */
.buffs-bar {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.9);
  border-bottom: 1rpx solid #EEE;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 倒计时大号显示 */
.countdown-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx 6rpx;
  background: rgba(255, 255, 255, 0.92);
  border-bottom: 2rpx solid #E0E0E0;
  z-index: 10;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 80rpx;
  width: 100%;
}

.countdown-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.countdown-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 2rpx;
}

.countdown-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.wrench-num {
  color: #FF9800;
}

.countdown-danger .countdown-label {
  color: #F44336;
}

.countdown-danger .countdown-num {
  color: #F44336;
  animation: countdownPulse 0.8s infinite;
}

@keyframes countdownPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.7; }
}

.buff-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  animation: buffIn 0.3s ease-out;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

@keyframes buffIn {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* Canvas */
.game-canvas {
  flex: 1;
  width: 100%;
  background: #E3F2FD;
}

/* 暂停遮罩 */
.pause-overlay {
  position: absolute;
  top: 70rpx;
  left: 0;
  right: 0;
  bottom: 150rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.pause-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.pause-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 操作按钮区 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 15rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-top: 2rpx solid #E0E0E0;
  height: 90rpx;
}

.action-btn {
  padding: 12rpx 36rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.pickup-btn {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
  animation: glow 1.5s infinite;
}

.repair-btn {
  background: linear-gradient(135deg, #F44336, #EF5350);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(244, 67, 54, 0.3);
  animation: glow 1.5s infinite;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(76, 175, 80, 0.6); }
}

.exit-btn {
  background: #F5F5F5;
  color: #999;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  font-weight: normal;
}

.action-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

/* Banner广告 */
.banner-ad {
  width: 100%;
  height: 80rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #E0E0E0;
}
