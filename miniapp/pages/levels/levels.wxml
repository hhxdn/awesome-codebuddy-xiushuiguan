<!-- pages/levels/levels.wxml - 关卡选择页 -->
<view class="page-levels">
  <!-- 顶部状态 -->
  <view class="levels-header">
    <view class="header-info">
      <text class="info-label">最高通关：</text>
      <text class="info-value">第{{highestLevel}}关</text>
      <text class="info-total"> / {{10000}}关</text>
    </view>
    <view class="header-page">
      <text class="page-info" bindtap="onGoToLatest">第{{currentPage * 15 + 1}}-{{(currentPage + 1) * 15 > 10000 ? 10000 : (currentPage + 1) * 15}}关</text>
      <text class="page-tip" bindtap="onShowTip">❓</text>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tip-area" wx:if="{{showTip}}">
    <text>🟢 绿色：已通关 | 🔵 蓝色边框：当前关卡 | ⚫ 灰色：未解锁</text>
  </view>

  <!-- 关卡网格 3列x5行 -->
  <view class="levels-grid">
    <view
      class="level-item {{item.cleared ? 'cleared' : ''}} {{item.current ? 'current' : ''}} {{!item.unlocked ? 'locked' : ''}}"
      wx:for="{{levels}}"
      wx:key="level"
      data-item="{{item}}"
      bindtap="onSelectLevel"
    >
      <view class="level-number">{{item.level}}</view>
      <view class="level-stars" wx:if="{{item.cleared}}">
        <text wx:for="{{[1,2,3]}}" wx:key="*this" class="star {{*this <= item.stars ? 'active' : ''}}">★</text>
      </view>
      <view class="level-lock" wx:if="{{!item.unlocked}}">🔒</view>
      <view class="level-current-icon" wx:if="{{item.current && item.unlocked}}">🔧</view>
    </view>
  </view>

  <!-- 翻页按钮 -->
  <view class="pagination">
    <button
      class="page-btn {{currentPage === 0 ? 'disabled' : ''}}"
      bindtap="onPrevPage"
      disabled="{{currentPage === 0}}"
    >
      ◀ 上一页
    </button>
    <view class="page-indicator">
      <text>{{currentPage + 1}} / {{totalPages}}</text>
    </view>
    <button
      class="page-btn {{currentPage >= totalPages - 1 ? 'disabled' : ''}}"
      bindtap="onNextPage"
      disabled="{{currentPage >= totalPages - 1}}"
    >
      下一页 ▶
    </button>
  </view>
</view>
