/* pages/index/index.wxss - 游戏首页样式 */
.page-index {
  min-height: 100vh;
  background: #E3F2FD;
  display: flex;
  flex-direction: column;
}

/* 品牌渐变背景区域 */
.header-area {
  background: linear-gradient(160deg, #0D47A1 0%, #1565C0 30%, #2196F3 60%, #42A5F5 100%);
  padding: 40rpx 30rpx 50rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-area::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-area::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 20%;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.title-decorator {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.decorator-icon {
  font-size: 50rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.subtitle-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 6rpx;
  margin-top: 8rpx;
  text-transform: uppercase;
}

/* 装饰场景区域 */
.scene-area {
  height: 280rpx;
  position: relative;
  background: linear-gradient(180deg, #B3E5FC 0%, #81D4FA 50%, #4FC3F7 100%);
  overflow: hidden;
}

.scene-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, #8D6E63 0%, #6D4C41 100%);
}

/* 维修车 */
.scene-truck {
  position: absolute;
  bottom: 50rpx;
  left: 60rpx;
  width: 160rpx;
  height: 100rpx;
}

.truck-body {
  width: 140rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  position: absolute;
  bottom: 20rpx;
  left: 10rpx;
}

.truck-window {
  width: 50rpx;
  height: 30rpx;
  background: #B3E5FC;
  border-radius: 4rpx;
  position: absolute;
  top: 10rpx;
  left: 60rpx;
}

.truck-wheel {
  width: 30rpx;
  height: 30rpx;
  background: #333;
  border-radius: 50%;
  position: absolute;
  bottom: 0;
  border: 4rpx solid #555;
}

.truck-wheel-l { left: 20rpx; }
.truck-wheel-r { right: 10rpx; }

/* 工人 */
.scene-worker {
  position: absolute;
  bottom: 55rpx;
  right: 80rpx;
  animation: workerBounce 2s ease-in-out infinite;
}

@keyframes workerBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.worker-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.worker-hat {
  width: 40rpx;
  height: 16rpx;
  background: #F44336;
  border-radius: 4rpx 4rpx 0 0;
}

.worker-face {
  font-size: 36rpx;
}

.worker-body {
  width: 44rpx;
  height: 50rpx;
  background: #1565C0;
  border-radius: 8rpx 8rpx 0 0;
  margin-top: -4rpx;
}

/* 水管装饰 */
.scene-pipe {
  position: absolute;
  background: #78909C;
  border-radius: 10rpx;
}

.pipe-1 {
  bottom: 80rpx;
  right: 30rpx;
  width: 60rpx;
  height: 16rpx;
}

.pipe-2 {
  bottom: 120rpx;
  right: 140rpx;
  width: 16rpx;
  height: 80rpx;
}

.scene-water {
  position: absolute;
  bottom: 95rpx;
  right: 28rpx;
  width: 8rpx;
  height: 20rpx;
  background: #4FC3F7;
  border-radius: 50%;
  animation: waterDrop 1s ease-in infinite;
}

@keyframes waterDrop {
  0% { height: 20rpx; opacity: 0.8; }
  100% { height: 60rpx; opacity: 0; }
}

/* 关卡信息 */
.level-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin: 0 30rpx;
  margin-top: -20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 2;
}

.level-label {
  font-size: 26rpx;
  color: #666666;
}

.level-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #1565C0;
  margin-left: 8rpx;
}

/* 按钮区域 */
.btn-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 20rpx;
  gap: 20rpx;
}

.btn-start {
  width: 100%;
  height: 100rpx !important;
  font-size: 36rpx !important;
  letter-spacing: 4rpx;
}

.btn-levels {
  width: 100%;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn-row .btn-small {
  flex: 1;
  height: 64rpx;
  background: rgba(33, 150, 243, 0.1);
  color: #2196F3;
  border: 1rpx solid rgba(33, 150, 243, 0.3);
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

/* 广告区 */
.ad-banner {
  width: 100%;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-top: 1rpx solid #E0E0E0;
}

.ad-text {
  color: #CCCCCC;
  font-size: 24rpx;
}

/* 底部 */
.footer-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx 50rpx;
  gap: 8rpx;
}

.footer-copyright {
  font-size: 22rpx;
  color: #BDBDBD;
}

.footer-privacy {
  font-size: 22rpx;
  color: #90CAF9;
  text-decoration: underline;
}

/* 隐私政策内容 */
.privacy-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  text-align: left;
}
