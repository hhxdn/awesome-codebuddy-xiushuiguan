<view class="game-page">
  <!-- 顶部精简栏：连击 + 暂停 -->
  <view class="top-bar">
    <view class="combo-badge" wx:if="{{comboCount >= 3}}">
      <text class="combo-text">🔥 x{{comboCount}}</text>
    </view>
    <view class="top-spacer"></view>
    <view class="pause-btn" bindtap="togglePause">
      <text class="pause-icon">{{gameState === 'paused' ? '▶' : '⏸'}}</text>
      <text class="pause-label">{{gameState === 'paused' ? '继续' : '暂停'}}</text>
    </view>
  </view>

  <!-- 活跃Buff指示器 -->
  <view class="buffs-bar" wx:if="{{activeBuffsList.length > 0}}">
    <view class="buff-tag" wx:for="{{activeBuffsList}}" wx:key="key" style="background: {{item.color}};">
      <text>{{item.icon}} {{item.name}}</text>
    </view>
  </view>

  <!-- 倒计时 + 扳手 + 金币 -->
  <view class="countdown-overlay {{timeLeft <= 10 ? 'countdown-danger' : ''}}">
    <view class="countdown-row">
      <view class="countdown-cell">
        <text class="countdown-label">⏱ 剩余时间</text>
        <text class="countdown-num">{{timeLeft}}s</text>
      </view>
      <view class="countdown-cell">
        <text class="countdown-label">🔧 扳手</text>
        <text class="countdown-num wrench-num">{{wrenchCount}}</text>
      </view>
      <view class="countdown-cell">
        <text class="countdown-label">🪙 金币</text>
        <text class="countdown-num coin-num">{{totalCoins}}</text>
      </view>
    </view>
  </view>

  <!-- 血条独立行（醒目大号） -->
  <view class="hp-row">
    <text class="hp-label">❤️ 血量</text>
    <view class="hp-bar-wrap">
      <view class="hp-bar-bg">
        <view class="hp-bar-fill" style="width: {{hp}}%; background: {{hp > 50 ? '#4CAF50' : (hp > 25 ? '#FF9800' : '#F44336')}};"></view>
      </view>
      <text class="hp-num">{{hp}}/{{maxHp}}</text>
    </view>
  </view>

  <!-- 游戏Canvas -->
  <canvas 
    type="2d" 
    id="gameCanvas" 
    class="game-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>

  <!-- 暂停遮罩 -->
  <view class="pause-overlay" wx:if="{{gameState === 'paused'}}">
    <view class="pause-text">⏸ 游戏暂停</view>
    <view class="pause-sub">点击播放按钮继续</view>
  </view>

  <!-- 动态按钮区域 -->
  <view class="action-bar">
    <view class="action-btn pickup-btn" wx:if="{{showPickupBtn}}" bindtap="onPickupWrench">
      <text>🔧 领取扳手</text>
    </view>
    <view class="action-btn repair-btn" wx:if="{{showRepairBtn}}" bindtap="onRepairPipe">
      <text>🔨 维修</text>
    </view>
    <view class="action-btn exit-btn" bindtap="exitGame">
      <text>退出</text>
    </view>
  </view>

  <!-- 底部Banner广告 -->
  <view class="banner-ad">
    <ad unit-id="adunit-banner-id" type="banner"></ad>
  </view>

  <!-- 通关胜利弹窗 -->
  <victory-dialog 
    show="{{showVictory}}" 
    level="{{level}}" 
    stars="{{victoryStars}}" 
    timeUsed="{{victoryTime}}"
    rewardCoins="{{rewardCoins}}"
    rewardMessage="{{rewardMessage}}"
    totalCoins="{{totalCoins}}"
    isFirstClear="{{isFirstClear}}"
    bind:next="onVictoryNext"
    bind:replay="onVictoryReplay"
    bind:share="onVictoryShare"
    bind:watchad="onVictoryWatchAd"
  />

  <!-- 失败弹窗 -->
  <defeat-dialog 
    show="{{showDefeat}}" 
    level="{{level}}" 
    reason="{{defeatReason}}"
    bind:retry="onDefeatRetry"
    bind:watchad="onDefeatWatchAd"
  />

  <!-- 激励视频福利弹窗 -->
  <reward-dialog 
    show="{{showReward}}"
    bind:select="onSelectReward"
    bind:close="onCloseReward"
  />
</view>
