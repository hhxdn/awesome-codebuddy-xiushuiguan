/* components/victory-dialog/victory-dialog.wxss */
.victory-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  margin: 0 60rpx;
  width: 520rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 星星区域 */
.stars-area {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.stars-area.show {
  opacity: 1;
  transform: scale(1);
}

.star-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.star-icon {
  font-size: 64rpx;
  color: #E0E0E0;
  transition: all 0.3s;
}

.star-icon.active {
  color: #FFC107;
  text-shadow: 0 0 20rpx rgba(255, 193, 7, 0.5);
}

.star-1 { animation: starPop 0.5s 0.2s both; }
.star-2 { animation: starPop 0.5s 0.4s both; }
.star-3 { animation: starPop 0.5s 0.6s both; }

@keyframes starPop {
  0% { transform: scale(0) rotate(-180deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* 标题 */
.victory-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

/* 关卡信息 */
.victory-info {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* ===== 奖励展示区 ===== */
.reward-area {
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 10rpx 24rpx;
  border: 2rpx solid #FFD54F;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.reward-area.show {
  opacity: 1;
  transform: translateY(0);
}

.reward-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.reward-icon {
  font-size: 36rpx;
}

.reward-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #E65100;
}

.first-badge {
  font-size: 20rpx;
  color: #FFF;
  background: #FF6F00;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  animation: badgePulse 1.5s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.reward-coins {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.coins-num {
  font-size: 52rpx;
  font-weight: bold;
  color: #FF6F00;
  text-shadow: 0 2rpx 8rpx rgba(255, 111, 0, 0.3);
}

.coins-label {
  font-size: 26rpx;
  color: #795548;
}

.reward-msg {
  font-size: 24rpx;
  color: #6D4C41;
  text-align: center;
  margin-bottom: 8rpx;
}

.reward-total {
  text-align: center;
  font-size: 22rpx;
  color: #8D6E63;
}

.total-num {
  font-weight: bold;
  color: #E65100;
  font-size: 26rpx;
}

/* ===== 按钮 ===== */
.victory-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.victory-btn-main {
  height: 96rpx !important;
  font-size: 36rpx !important;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-row button {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.ad-reward {
  padding: 16rpx;
  font-size: 24rpx;
  color: #FF9800;
  text-decoration: underline;
}
