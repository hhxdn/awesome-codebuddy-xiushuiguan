/* components/reward-dialog/reward-dialog.wxss */

/* 遮罩层 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.reward-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 30rpx 30rpx;
  width: 580rpx;
  max-height: 85vh;
  overflow-y: auto;
  text-align: center;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.3);
  position: relative;
  animation: cardIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cardIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 关闭按钮 */
.close-area {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 32rpx;
  color: #999999;
  font-weight: bold;
}

/* 标题 */
.reward-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.reward-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 30rpx;
}

/* 福利列表 */
.reward-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reward-option {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  gap: 16rpx;
  transition: all 0.2s;
}

.reward-option:active {
  background: #F0F0F0;
  transform: scale(0.98);
}

.option-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-align: left;
  overflow: hidden;
}

.option-title {
  font-size: 28rpx;
  font-weight: bold;
}

.option-desc {
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.option-btn {
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 底部 */
.reward-footer {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #BDBDBD;
}
