/* pages/settings/settings.wxss - 设置页面样式 */
.page-settings {
  min-height: 100vh;
  background: #E3F2FD;
  display: flex;
  flex-direction: column;
}

.settings-container {
  flex: 1;
  padding: 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
}

.setting-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 36rpx;
}

.setting-text {
  font-size: 30rpx;
  color: #333333;
}

.danger-text {
  color: #F44336;
}

.setting-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
}

.setting-link {
  cursor: pointer;
}

.setting-link:active {
  background: #F5F5F5;
}

.settings-footer {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 60rpx;
}

.settings-footer .btn-secondary {
  width: 80%;
}

.version-text {
  font-size: 24rpx;
  color: #BDBDBD;
}
