<!-- components/victory-dialog/victory-dialog.wxml - 通关胜利弹窗 -->
<view class="dialog-mask" wx:if="{{show}}" bindtap="stopPropagation">
  <view class="victory-card" catchtap="stopPropagation">
    <!-- 星星动画 -->
    <view class="stars-area {{showStars ? 'show' : ''}}">
      <view class="star-item star-1">
        <text class="star-icon {{stars >= 1 ? 'active' : ''}}">★</text>
      </view>
      <view class="star-item star-2">
        <text class="star-icon {{stars >= 2 ? 'active' : ''}}">★</text>
      </view>
      <view class="star-item star-3">
        <text class="star-icon {{stars >= 3 ? 'active' : ''}}">★</text>
      </view>
    </view>

    <!-- 标题 -->
    <view class="victory-title">🎉 恭喜通关！</view>

    <!-- 关卡信息 -->
    <view class="victory-info">
      <text class="info-item">第{{level}}关</text>
      <text class="info-item">用时 {{timeUsed}} 秒</text>
    </view>

    <!-- 奖励展示区 -->
    <view class="reward-area {{showReward ? 'show' : ''}}" wx:if="{{rewardCoins > 0}}">
      <view class="reward-header">
        <text class="reward-icon">💰</text>
        <text class="reward-title">通关奖励</text>
        <text class="first-badge" wx:if="{{isFirstClear}}">首次通关</text>
      </view>
      <view class="reward-coins">
        <text class="coins-num">+{{rewardCoins}}</text>
        <text class="coins-label">金币</text>
      </view>
      <view class="reward-msg">{{rewardMessage}}</view>
      <view class="reward-total" wx:if="{{totalCoins > 0}}">
        <text>当前金币：</text>
        <text class="total-num">{{totalCoins}}</text>
      </view>
    </view>

    <!-- 按钮 -->
    <view class="victory-buttons">
      <button class="btn-success victory-btn-main" bindtap="onNextLevel">
        ▶ 下一关
      </button>
      <view class="btn-row">
        <button class="btn-secondary" bindtap="onReplay">🔄 再来一局</button>
        <button class="btn-primary" open-type="share" bindtap="onShare">📤 分享好友</button>
      </view>
      <view class="ad-reward" bindtap="onRewardAd">
        <text>🎬 看广告额外奖励</text>
      </view>
    </view>
  </view>
</view>
