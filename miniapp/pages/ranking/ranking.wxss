/* pages/ranking/ranking.wxss - 好友排行榜样式 */
.page-ranking {
  min-height: 100vh;
  background: #E3F2FD;
  display: flex;
  flex-direction: column;
}

/* 我的排名卡片 */
.my-rank-card {
  background: linear-gradient(135deg, #1565C0, #2196F3);
  padding: 24rpx 30rpx;
}

.my-rank-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.my-rank-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.my-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 40rpx;
}

.my-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.my-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.my-level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.my-rank-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.rank-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFC107;
}

/* 排行榜标题 */
.rank-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
}

.rank-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.rank-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #2196F3;
  padding: 8rpx 16rpx;
  background: rgba(33, 150, 243, 0.1);
  border-radius: 20rpx;
}

/* 排行列表 */
.rank-list {
  flex: 1;
  padding: 0 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.rank-item.is-me {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border: 2rpx solid #2196F3;
}

.rank-badge {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.rank-badge.top1,
.rank-badge.top2,
.rank-badge.top3 {
  font-size: 40rpx;
}

.rank-num-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #999999;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.rank-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rank-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.rank-level {
  font-size: 24rpx;
  color: #666666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 加载 */
.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
}

/* 开放数据域占位 */
.open-data-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.placeholder-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.placeholder-hint {
  font-size: 24rpx;
  color: #BDBDBD;
}

/* 底部按钮 */
.rank-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 60rpx;
}

.rank-footer button {
  flex: 1;
  font-size: 28rpx;
}
