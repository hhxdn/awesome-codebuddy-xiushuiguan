/* components/victory-dialog/victory-dialog.wxss */
.victory-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  margin: 0 60rpx;
  width: 520rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 星星区域 */
.stars-area {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.stars-area.show {
  opacity: 1;
  transform: scale(1);
}

.star-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.star-icon {
  font-size: 64rpx;
  color: #E0E0E0;
  transition: all 0.3s;
}

.star-icon.active {
  color: #FFC107;
  text-shadow: 0 0 20rpx rgba(255, 193, 7, 0.5);
}

.star-1 { animation: starPop 0.5s 0.2s both; }
.star-2 { animation: starPop 0.5s 0.4s both; }
.star-3 { animation: starPop 0.5s 0.6s both; }

@keyframes starPop {
  0% { transform: scale(0) rotate(-180deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* 标题 */
.victory-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

/* 关卡信息 */
.victory-info {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* 按钮 */
.victory-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.victory-btn-main {
  height: 96rpx !important;
  font-size: 36rpx !important;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-row button {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.ad-reward {
  padding: 16rpx;
  font-size: 24rpx;
  color: #FF9800;
  text-decoration: underline;
}
